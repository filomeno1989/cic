# ============================================================
# CIC Fragrâncias & Glamour - Variáveis de Ambiente
# Copie este ficheiro para .env (local) ou cole os valores
# em Vercel → Project → Settings → Environment Variables
# ============================================================

# ---------- BASE DE DADOS (Supabase PostgreSQL) ----------
# Em Supabase → Project Settings → Database → Connection string:
#
# DATABASE_URL (Runtime - Vercel): usar a conexão POOLED (Transaction pooler, porta 6543)
#   postgresql://postgres.<ref-do-projecto>:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
#
# DIRECT_URL (Migrações - prisma db push): conexão DIRECTA (porta 5432)
#   postgresql://postgres.<ref-do-projecto>:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
DATABASE_URL=
DIRECT_URL=

# ---------- SEGREDO DE SESSÃO ----------
# Assinatura HMAC dos cookies de sessão. GERAR um valor único:
#   openssl rand -hex 32   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# IMPORTANTE: se mudar este valor, todos terão de iniciar sessão de novo.
AUTH_SECRET=

# ---------- LOCAL (opcional) ----------
# Para testar localmente com SQLite (ficheiro db/custom.db),
# use o schema.prisma original com:
#   DATABASE_URL="file:./db/custom.db"
