generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ============ RECURSOS HUMANOS / ACESSOS ============
model User {
  id            String        @id @default(cuid())
  name          String
  pin           String // PIN de acesso (4-6 digitos)
  role          String        @default("CAIXA") // GERENTE | CAIXA
  active        Boolean       @default(true)
  isSystem      Boolean       @default(false) // conta do proprietário (Manutenção): invisível na RH e intocável por gerentes
  phone         String?
  baseSalary    Float         @default(0)
  commissionPct Float         @default(0) // % comissao sobre vendas
  sales         Sale[]
  vales         Vale[]
  closings      CashClosing[]
  expenses      Expense[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Vale {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  reason    String?
  paidOut   Boolean  @default(false) // descontado na folha
  date      DateTime @default(now())
}

// ============ PRODUTOS E STOCK ============
model Product {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  category   String          @default("Geral")
  brand      String?
  imagem     String? // URL da foto (servida em /api/imagens/<id>) - para catalogo e portal /loja
  imagemRel  ProductImage?
  variants   ProductVariant[]
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// Bytes da foto guardados na propria base de dados (aditivo, nao toca em produtos existentes)
model ProductImage {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mime      String   @default("image/jpeg")
  dados     Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color           String? // Tom / Cor
  size            String? // Tamanho / Volume
  costPrice       Float       @default(0)
  retailPrice     Float       @default(0) // Preco retalho
  wholesalePrice  Float? // Preco grosso/revenda
  wholesaleMinQty Int         @default(3) // Qtd minima p/ preco grosso
  stock           Int         @default(0)
  minStock        Int         @default(3)
  expiryDate      DateTime?
  active          Boolean     @default(true)
  saleItems       SaleItem[]
  stockEntries    StockEntry[]
  stockLosses     StockLoss[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model StockEntry {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  qty       Int
  costPrice Float
  supplier  String?
  userId    String
  date      DateTime       @default(now())
}

model StockLoss {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  qty       Int
  reason    String // DERRETEU | PARTIU | EXPIROU | ROUBO | OUTRO
  notes     String?
  userId    String
  date      DateTime       @default(now())
}

// ============ CLIENTES E FIACAO ============
model Customer {
  id          String          @id @default(cuid())
  name        String
  phone       String? // WhatsApp
  creditLimit Float           @default(0)
  notes       String?
  sales       Sale[]
  payments    CreditPayment[]
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CreditPayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  method     String   @default("DINHEIRO")
  userId     String
  note       String?
  date       DateTime @default(now())
}

// ============ VENDAS ============
model Sale {
  id                String        @id @default(cuid())
  number            Int // sequencial
  localId           String?       @unique // id gerado no aparelho (idempotência: replay da sincronização NÃO duplica venda)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  subtotal          Float
  discount          Float         @default(0)
  total             Float
  status            String        @default("CONCLUIDA") // CONCLUIDA | ANULADA
  isCredit          Boolean       @default(false)
  priceType         String        @default("RETALHO") // RETALHO | GROSSO
  commission        Float         @default(0)
  offline           Boolean       @default(false) // sincronizada de offline
  clientCreatedAt   DateTime? // data real da venda offline
  items             SaleItem[]
  payments          Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model SaleItem {
  id           String         @id @default(cuid())
  saleId       String
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  name         String // snapshot nome produto
  variantLabel String? // snapshot "Tom 3 / 30ml"
  qty          Int
  unitPrice    Float
  total        Float
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String // DINHEIRO | MPESA | EMOLA | MKESH | POS | CREDITO
  amount    Float
  change    Float    @default(0) // troco (dinheiro)
  reference String? // ID transacao M-Pesa/POS
}

model Counter {
  id         String @id @default("sale")
  saleNumber Int    @default(0)
}

// ============ FINANCEIRO ============
model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amount      Float
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now())
}

model CashClosing {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  countedCash   Float // contado pelo caixa (cego)
  countedPos    Float
  countedMpesa  Float
  expectedCash  Float
  expectedPos   Float
  expectedMpesa Float
  diffCash      Float // visivel apenas ao gerente
  diffPos       Float
  diffMpesa     Float
  // P2: carteiras separadas (null = fecho no formato antigo, mobile money mesclado)
  countedEmola  Float?
  expectedEmola Float?
  diffEmola     Float?
  countedMkesh  Float?
  expectedMkesh Float?
  diffMkesh     Float?
  salesTotal    Float
  note          String?
  closedAt      DateTime @default(now())
}

model Settings {
  id                String  @id @default("main")
  storeName         String  @default("CIC Fragrâncias & Glamour")
  phone             String  @default("")
  address           String  @default("Beira, Moçambique")
  receiptFooter     String  @default("Obrigado pela preferência! Volte sempre.")
  thermalWidth      String  @default("80") // 58 | 80
  nuit              String  @default("")
  expenseCategories String  @default("") // JSON array de categorias de despesa (fixas)
  productCategories String  @default("") // JSON array de categorias de produtos
  productBrands     String  @default("") // JSON array de marcas
  whatsappLoja      String  @default("") // WhatsApp CTA do portal do cliente /loja
  instagramUrl      String  @default("") // link completo do Instagram (redes sociais no /loja)
  facebookUrl       String  @default("") // link completo do Facebook (redes sociais no /loja)
  tiktokUrl         String  @default("") // link completo do TikTok (preparado para o futuro)
}
